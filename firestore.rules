rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn()  { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }

    // users — staff can read own doc, admin can read/write all
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // depot_stock — everyone reads, only admins write
    match /depot_stock/{itemId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // location_stock — everyone authenticated can read/write
    match /location_stock/{docId} {
      allow read, write: if isSignedIn();
    }

    // reports — staff can create + read own; admins can do everything
    match /reports/{reportId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // stock_entries — audit log; only admins
    match /stock_entries/{entryId} {
      allow read, write: if isAdmin();
    }

    // products — dynamic product catalogue, only admins write
    match /products/{productId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
